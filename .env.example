# Base de données (fournie par Render, Railway, ou ta propre instance PostgreSQL)
DATABASE_URL="postgresql://user:password@localhost:5432/bouda_tech"

# Authentification
JWT_SECRET="change-moi-avec-une-longue-chaine-aleatoire"

# Mode e-mail : "sandbox" (journalisé en base, rien n'est réellement envoyé)
# ou "live" (envoi réel via un compte SMTP — Brevo, Zoho, etc.)
EMAIL_MODE="sandbox"
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
EMAIL_FROM="BOUDA-TECH <no-reply@bouda-tech.bf>"
CONTACT_EMAIL_TO="ernestbouda@yahoo.fr"

# Mode SMS : "sandbox" (journalisé dans les logs) ou "live" (Africa's Talking)
SMS_MODE="sandbox"
AFRICASTALKING_API_KEY=""
AFRICASTALKING_USERNAME=""

# Cle secrete pour proteger les routes de taches planifiees (rappels, avis)
CRON_SECRET="change-moi-aussi"

# Mode paiement : "sandbox" (simulation) ou "live" (vrais operateurs)
PAYMENT_MODE="sandbox"

